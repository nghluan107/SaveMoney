rules_version = '2';
// Chỉ 2 email trong danh sách mới được đọc / ghi dữ liệu.
// Thay 2 email mẫu bên dưới bằng email Google của chồng và vợ,
// rồi dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['email-chong@gmail.com', 'email-vo@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
